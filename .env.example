# ── Supabase (leave blank to run in local-only mode) ─────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key. Browsers no longer talk to PostgREST directly (all DB
# access goes through route handlers), but its presence is what flips the app
# from local mode to synced mode.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side, privileged key — used ONLY by route handlers.
# Prefer the new secret key; the legacy service_role key also works.
# Dashboard → Settings → API Keys → Publishable and secret API keys
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=            # legacy fallback

# Signs the httpOnly session cookie (>= 32 chars, REQUIRED when Supabase is
# configured — the app refuses to start with the dev default).
#   generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── App ──────────────────────────────────────────────────────────────────────
# Local-mode school code, and a cache key. NOT a key into the database: every
# table references school(id) and resolveSchool() reads the active school row,
# so an administrator may change `kod_sekolah` from /pentadbiran without
# touching this. Changing it here still needs a rebuild — NEXT_PUBLIC_* is
# inlined at build time — which is precisely why nothing may depend on it.
NEXT_PUBLIC_SCHOOL_CODE=SK0000

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Teachers sign in with their KPM/DELIMa Google account instead of a password.
# Everything here is optional: leave it empty and no button renders and nothing
# is requested from Google. Password login stays either way — it is the only
# route in local mode, and the only route for anyone without an MOE account.
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Authorised JavaScript origin must be your real
# origin — the consent screen must be "External", which needs no verification
# review because openid/email/profile are non-sensitive scopes.
#
# Public: the browser has to render the button with them. None is a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# The Workspace domain teachers' accounts live on. Google issues the `hd` claim
# only to Workspace accounts, and its absence is treated as a rejection — so
# this is the value that decides between "teachers at this school" and
# "anyone with a Gmail address".
NEXT_PUBLIC_GOOGLE_DOMAIN=moe-dl.edu.my
# Server-only. Never prefixed NEXT_PUBLIC_, and read only by /api/auth/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
