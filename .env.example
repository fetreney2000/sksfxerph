# ── Supabase (leave blank to run in local-only mode) ─────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key. Browsers no longer talk to PostgREST directly (all DB
# access goes through route handlers), but its presence is what flips the app
# from local mode to synced mode.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side, privileged key — used ONLY by route handlers.
# Prefer the new secret key; the legacy service_role key also works.
# Dashboard → Settings → API Keys → Publishable and secret API keys
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=            # legacy fallback

# Signs the httpOnly session cookie (>= 32 chars, REQUIRED when Supabase is
# configured — the app refuses to start with the dev default).
#   generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── App ──────────────────────────────────────────────────────────────────────
# Where the school / single tenant lives. Must match `school.kod_sekolah` in db/schema.sql
NEXT_PUBLIC_SCHOOL_CODE=SK0000
